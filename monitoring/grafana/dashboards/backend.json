{
  "uid": "osint-backend",
  "title": "Backend — requests and sources",
  "description": "The FastAPI process: request rate and latency by route, per-source freshness, cache and rate-limit occupancy, and pool state. Scraped from backend:8000/metrics (backend/metrics.py). Provisioned from monitoring/grafana/dashboards/backend.json; edits in the UI are not persisted.",
  "tags": ["osint", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend",
      "description": "Prometheus' own view of the scrape. 0 means /metrics did not answer — which, since the exposition is built purely from process memory, means the process itself is gone or the event loop is blocked.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "up{job=\"backend\"}", "instant": true, "legendFormat": "up" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / sec",
      "description": "Every route except /metrics, which excludes itself so the scrape does not floor this at a non-zero idle rate.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(rate(osint_http_requests_total[$__rate_interval]))", "instant": true, "legendFormat": "rps" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx share",
      "description": "Server errors as a fraction of all responses. 4xx is excluded deliberately: a 404 from a scanner is not this service failing.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 6, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(osint_http_requests_total{status=~\"5..\"}[$__rate_interval])) / sum(rate(osint_http_requests_total[$__rate_interval]))",
        "instant": true, "legendFormat": "5xx"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "description": "Across all routes. Most responses here are a 304 or an in-memory filter, so a p95 in the hundreds of milliseconds means something is reaching Postgres on a hot path.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(osint_http_request_duration_seconds_bucket[$__rate_interval])))",
        "instant": true, "legendFormat": "p95"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sources in error",
      "description": "Sources whose last poll left an error outstanding. Counts the backend's own pollers plus every mirrored kind it follows.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 14, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(osint_source_up == bool 0)", "instant": true, "legendFormat": "in error" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 4 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Open alerts",
      "description": "Unresolved rows in the alerts table, as written by the cache worker. Refreshed every 30s off the scrape path.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(osint_alerts_active)", "instant": true, "legendFormat": "open" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Resident memory",
      "description": "The backend process' RSS. Every source keeps its full payload in memory — FIRMS alone runs to 175k points — so this is expected to be large and flat, not small.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes{job=\"backend\"}", "instant": true, "legendFormat": "rss" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests / sec, by route",
      "description": "Route templates, never raw paths — /api/track/{kind}/{entity_id} is one series regardless of how many entities are tracked.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "refId": "A", "expr": "topk(12, sum by (route) (rate(osint_http_requests_total[$__rate_interval])))", "legendFormat": "{{route}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Responses / sec, by status",
      "description": "304 dominating is the ETag path working as designed — the client asked, nothing had changed, no body was sent. 5xx is the only band that should ever be empty.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(osint_http_requests_total[$__rate_interval]))", "legendFormat": "{{status}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 25, "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "200" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "304" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "500" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "503" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Latency quantiles",
      "description": "From the request histogram. p50 and p95 diverging by orders of magnitude is the normal shape here: a 304 and a full Postgres-backed replay are the same endpoint family, not the same work.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(osint_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(osint_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(osint_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" },
        { "refId": "D", "expr": "sum(rate(osint_http_request_duration_seconds_sum[$__rate_interval])) / sum(rate(osint_http_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "mean" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "p95 latency, by route",
      "description": "Which endpoint is actually slow. The ten worst, so one pathological route cannot hide behind forty fast ones.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "refId": "A",
        "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(osint_http_request_duration_seconds_bucket[$__rate_interval]))))",
        "legendFormat": "{{route}}"
      }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "In-flight requests and pool connections",
      "description": "One event loop serves everything, so in-flight requests stacking up means something is blocking it rather than that traffic is high. in_use pinned at max is the other stall: requests queueing for a connection.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "osint_http_requests_in_flight", "legendFormat": "in flight" },
        { "refId": "B", "expr": "osint_db_pool_connections{state=\"in_use\"}", "legendFormat": "pool in use" },
        { "refId": "C", "expr": "osint_db_pool_connections{state=\"idle\"}", "legendFormat": "pool idle" },
        { "refId": "D", "expr": "osint_db_pool_max_connections", "legendFormat": "pool max" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pool max" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }] }
        ]
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Redis payload cache / sec",
      "description": "Backend-side view of the cache, which the cache worker's Redis INFO counters cannot give: `stale` means an entry existed and the data moved on (healthy), `miss` means it was not there at all, `error` means Redis is unreachable and every read is going to Postgres.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "targets": [{ "refId": "A", "expr": "sum by (operation, result) (rate(osint_cache_operations_total[$__rate_interval]))", "legendFormat": "{{operation}} · {{result}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*error.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "get · hit" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Hits as a share of all cache reads. Stale entries count against it on purpose — a stale read costs the same Postgres rebuild a miss does.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(osint_cache_operations_total{operation=\"get\",result=\"hit\"}[$__rate_interval])) / sum(rate(osint_cache_operations_total{operation=\"get\"}[$__rate_interval]))",
        "legendFormat": "hit ratio"
      }],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 0.8 }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },

    {
      "id": 17,
      "type": "timeseries",
      "title": "On-demand upstreams / sec",
      "description": "The two proxies that fetch when a client asks rather than on a timer. `hit` never reached the network; `rate_limited` was declined by the token bucket before spending quota.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "targets": [{ "refId": "A", "expr": "sum by (upstream, result) (rate(osint_upstream_requests_total[$__rate_interval]))", "legendFormat": "{{upstream}} · {{result}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*error.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*rate_limited.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Rate-limit tokens available",
      "description": "What the token buckets would grant right now, against their burst size. Reaching zero is where the 503 + Retry-After responses come from — deliberate, not a failure.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "osint_ratelimit_tokens_available", "legendFormat": "{{bucket}} available" },
        { "refId": "B", "expr": "osint_ratelimit_tokens_capacity", "legendFormat": "{{bucket}} capacity" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["min", "lastNotNull"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*capacity" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }, { "id": "custom.fillOpacity", "value": 0 }] }
        ]
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "In-process cache entries",
      "description": "Occupancy of the bounded LruTtlCaches. A cache sitting at its cap is evicting entries that are still wanted, which shows up as upstream calls rather than as an error anywhere.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "targets": [{ "refId": "A", "expr": "osint_local_cache_entries", "legendFormat": "{{cache}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 20,
      "type": "table",
      "title": "Source freshness",
      "description": "Seconds since each source last succeeded, worst first. A source with no row here has never succeeded in this process — deliberately absent rather than reported as 0, which would read as 'just refreshed'.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 36 },
      "targets": [{ "refId": "A", "expr": "topk(20, osint_source_seconds_since_success)", "instant": true, "format": "table" }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "monitor": true },
            "renameByName": { "source": "Source", "Value": "Since last success" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Since last success", "desc": true }] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Since last success" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 3600 }, { "color": "orange", "value": 21600 }, { "color": "red", "value": 86400 }] } }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Items held, by source",
      "description": "What each source is currently serving. A step to zero on a source that was populated is the shape of a poll that succeeded and returned nothing — invisible in /api/health, which only shows the current number.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 36 },
      "targets": [{ "refId": "A", "expr": "topk(15, osint_source_items)", "legendFormat": "{{source}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "Source refreshes / hour",
      "description": "How often each source actually replaces its payload — the same counter the HTTP ETags are built from. Compare against the configured poll interval: a source polling on schedule but never refreshing is fetching and discarding.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "targets": [{ "refId": "A", "expr": "topk(15, rate(osint_source_refresh_total[$__rate_interval]) * 3600)", "legendFormat": "{{source}}" }],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Process, storage and alerts",
      "description": "CPU and memory for the backend container, plus the two binary facts worth seeing beside them: whether the asyncpg pool exists at all, and how many alerts are open.",
      "datasource": { "type": "prometheus", "uid": "osint-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"backend\"}[$__rate_interval])", "legendFormat": "cpu cores" },
        { "refId": "B", "expr": "process_resident_memory_bytes{job=\"backend\"}", "legendFormat": "resident memory" },
        { "refId": "C", "expr": "osint_storage_up", "legendFormat": "storage up" },
        { "refId": "D", "expr": "sum by (severity) (osint_alerts_active)", "legendFormat": "alerts · {{severity}}" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "resident memory" }, "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.axisPlacement", "value": "right" }] },
          { "matcher": { "id": "byName", "options": "storage up" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    }
  ]
}
