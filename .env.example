# Copy this file to ".env" (same folder) and fill in the values you have.
# The app works fine with some of these blank -- those layers will just be
# empty until you add the key and restart. See README.md for how to get each one.

# NASA FIRMS (fires/thermal anomalies) -- instant, free
# Get it at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# aisstream.io (live ship positions) -- free registration
# Get it at: https://aisstream.io
AISSTREAM_API_KEY=

# OpenSky Network (live aircraft positions) -- optional but recommended.
# Without this the app still works using anonymous access (100 requests/day).
# Register at https://opensky-network.org, then create an API client under
# your account settings to get these.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ACLED (conflict/violence events) -- your myACLED account email + password.
# Register at https://acleddata.com and request API access.
# This is sent only to ACLED's own login endpoint over HTTPS, and stays only
# in this local file -- never commit .env to source control.
ACLED_EMAIL=
ACLED_PASSWORD=

# OpenWeatherMap (cloud cover / wind layers) -- optional, free tier.
# The live precipitation radar layer needs no key at all and always works.
# Get a key at: https://home.openweathermap.org/api_keys (free account)
OWM_API_KEY=

# Global Fishing Watch (satellite vessel detections -- optical and SAR) --
# free, self-service. Register an application at:
# https://globalfishingwatch.org/our-apis/tokens
# Licensed CC BY-NC 4.0: non-commercial use only, and the restriction carries
# over to anything derived from it.
# Without this the satellite detection layer stays empty; AIS-based dark-vessel
# inference in backend/sources/dark_vessels.py is unaffected and keeps working.
GFW_API_TOKEN=

# --- Egress proxies (optional, off by default) ------------------------------
# Routes a collector's outbound connection through a public proxy when, and only
# when, the direct connection keeps failing. This is for one specific problem:
# a source that has blocked or throttled this machine's IP while the account and
# key are still good. It does nothing for a source that is down for everyone --
# a different IP reaches the same down service.
#
# Read the source's terms before turning this on. Routing around a block is a
# decision about an account you own and can lose, and aisstream in particular
# limits by account as well as by IP. Off is the right default.
#
# The proxy list is Proxifly's (github.com/proxifly/free-proxy-list), fetched
# fresh, and only fetched once a direct connection has already failed several
# times. Traffic through it is TLS to the origin, tunnelled by CONNECT or SOCKS,
# so a proxy operator sees which host was reached and nothing inside.
PROXY_ENABLED=
# Comma-separated, best first. socks5, socks4 and http are the supported values.
PROXY_PROTOCOLS=socks5,socks4,http
# Consecutive failed direct connections before the AIS stream tries a proxy, and
# how many proxies one reconnect cycle may try. Keep the second small: it
# multiplies how many connections a cycle makes to the source.
AIS_PROXY_AFTER_FAILURES=3
AIS_PROXY_ATTEMPTS=3

# --- Grafana (monitoring dashboard at http://localhost:3000) ----------------
# Only the Grafana login. Nothing here is read by the app, and no source
# depends on it -- the monitoring containers observe Postgres and change
# nothing.
#
# Blank means admin / admin, which is fine while port 3000 is only reachable
# from this machine. Set a real password before exposing it to anything else.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
