{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "frontend-8080",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "8080", "--strictPort"],
      "cwd": "frontend",
      "port": 8080
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "backend.app"],
      "port": 8000,
      "autoPort": true
    }
  ]
}
